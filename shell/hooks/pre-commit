#!/usr/bin/env bash
# pre-commit hook: auto-increment the patch version in build.gradle.kts

ROOT="$(git rev-parse --show-toplevel)"
GRADLE_FILE="$ROOT/build.gradle.kts"

if [[ ! -f "$GRADLE_FILE" ]]; then
    echo "pre-commit: build.gradle.kts not found, skipping version bump" >&2
    exit 0
fi

# Portable across GNU/BSD (no grep -P, no sed -i)
current=$(sed -nE 's/^version[[:space:]]*=[[:space:]]*"([0-9]+\.[0-9]+\.[0-9]+)".*/\1/p' "$GRADLE_FILE")

if [[ -z "$current" ]]; then
    echo "pre-commit: no semver version found in build.gradle.kts, skipping bump" >&2
    exit 0
fi

major="${current%%.*}"
rest="${current#*.}"
minor="${rest%%.*}"
patch="${rest##*.}"

next_patch=$((patch + 1))
next="${major}.${minor}.${next_patch}"

perl -pi -e "s/^version = \"\Q${current}\E\"/version = \"${next}\"/" "$GRADLE_FILE"
git add "$GRADLE_FILE"

echo "pre-commit: version bumped ${current} → ${next}"